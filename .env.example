# Google Cloud configuration
GCP_PROJECT_ID=pubsub-event-pipeline

# Pub/Sub resources
PUBSUB_TOPIC_ID=demo-events
PUBSUB_SUBSCRIPTION_ID=demo-events-sub

# Host path to the service-account JSON file.
# Use Application Default Credentials instead if configured.
GCP_CREDENTIALS_FILE=./secrets/gcp-key.json

# Path inside the containers.
GOOGLE_APPLICATION_CREDENTIALS_CONTAINER=/var/secrets/gcp/key.json

# Producer configuration
PUBLISH_INTERVAL_SECONDS=5
EVENT_TYPE=demo.event
EVENT_SOURCE=pubsub-producer

# Consumer configuration
MAX_IN_FLIGHT_MESSAGES=100

# Optional Pub/Sub emulator.
# Leave empty to use Google Cloud Pub/Sub.
PUBSUB_EMULATOR_HOST=

# Logging
LOG_LEVEL=INFO